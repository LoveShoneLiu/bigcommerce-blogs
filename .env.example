# Environment
APP_URL="https://your-app.vercel.app"
BC_CLIENT_ID=""
BC_CLIENT_SECRET=""
TOKEN_ENCRYPTION_KEY=""

# Neon (Vercel Postgres)
# DATABASE_URL = pooled connection used by Prisma at runtime
# DIRECT_URL = direct (non-pooling) connection used by migrations
DATABASE_URL=""
DIRECT_URL=""

# Optional. Override automatic storefront cache-busting.
# On Vercel this defaults to the git commit SHA (VERCEL_GIT_COMMIT_SHA).
# STOREFRONT_ASSET_VERSION="manual-override"
