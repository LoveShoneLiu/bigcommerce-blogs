# Environment
APP_URL="https://your-app.vercel.app"
BC_CLIENT_ID=""
BC_CLIENT_SECRET=""
TOKEN_ENCRYPTION_KEY=""

# Neon (Vercel Postgres)
# DATABASE_URL = pooled connection used by Prisma at runtime
# DIRECT_URL = direct (non-pooling) connection used by migrations
DATABASE_URL=""
DIRECT_URL=""

# Optional. Bump to refresh storefront CSS/JS after deploy.
STOREFRONT_ASSET_VERSION="7"
